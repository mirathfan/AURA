rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid && !firestore.exists(/databases/(default)/documents/accountDeletionJobs/$(uid));
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size <= 10 * 1024 * 1024;
    }

    function isValidTranscriptionAudio() {
      return request.resource.size <= 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('audio/.*') ||
          request.resource.contentType == 'video/mp4'
        );
    }

    match /users/{uid}/tmp/transcription/{recordingId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidTranscriptionAudio();
      allow delete: if false;
    }

    match /users/{uid}/{filename} {
      allow read: if isOwner(uid);
      allow delete: if false;
      allow create: if isOwner(uid) && isValidImage();
    }
    function itemActive(uid, itemId) {
      return !firestore.exists(/databases/(default)/documents/users/$(uid)/itemDeletionJobs/$(itemId));
    }
    match /users/{uid}/items/{filename} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && itemActive(uid, filename.split('[.]')[0]) && isValidImage();
      allow delete: if false;
    }
    match /users/{uid}/items/{itemId}/{filename}/{allPaths=**} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && itemActive(uid, itemId) && isValidImage();
      allow delete: if false;
    }
    match /users/{uid}/{folder}/{allPaths=**} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && folder != 'items' && isValidImage();
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
