# Optional override for canonical and social metadata URLs.
# Vercel deployment URLs are detected automatically when this is unset.
NEXT_PUBLIC_SITE_URL=https://aura-kasatlabs.vercel.app

# Beta 1 support/ privacy contact: support@getaura.app.
# Canonical contacts are generated from shared/privacyPolicy.ts (no email override).

# Google Sheets beta signup integration.
# Preferred: token-protected Apps Script web app bound to the signup sheet.
GOOGLE_APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_APPS_SCRIPT_TOKEN=replace-with-a-long-random-token

# Alternative: direct Google Sheets API access through a service account.
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEETS_RANGE=Sheet1!A:B
GOOGLE_SERVICE_ACCOUNT_EMAIL=aura-beta-signups@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-key\n-----END PRIVATE KEY-----\n"
