{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "autoIncrement": true,
      "credentialsSource": "local",
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_AURA_AGENT_ENABLED": "1"
      },
      "environment": "production",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0",
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "autoIncrement": true,
      "credentialsSource": "local",
      "env": {
        "EXPO_PUBLIC_AURA_AGENT_ENABLED": "1"
      },
      "environment": "production",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0",
        "resourceClass": "m-medium"
      }
    },
    "beta-simulator": {
      "extends": "production",
      "autoIncrement": false,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6768546665"
      }
    }
  }
}
